# Canonical production origin, e.g. https://your-domain.example (no trailing slash).
# Vercel automatically falls back to VERCEL_PROJECT_PRODUCTION_URL when omitted.
SITE_URL=

# Content backend
# Use "sanity" in production. "local" is only a development fallback.
DATA_SOURCE=sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-08-22
SANITY_READ_TOKEN=
SANITY_USE_CDN=true
SANITY_CACHE_TTL_MS=30000
SANITY_WEBHOOK_SECRET=

# Sanity Studio: ONLY public identifiers may use the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Required only by `npm run sanity:seed`; never prefix this with PUBLIC_ or SANITY_STUDIO_.
SANITY_WRITE_TOKEN=

# MongoDB Atlas connection used only by the Astro server
MONGODB_URI=
MONGODB_DB_NAME=portfolio

# Brevo credentials used only by the Astro server
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Engineering Notebook

# Inbox that receives new-message notifications
LEAD_NOTIFY_EMAIL=
