{
  "name": "engineering-notebook-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && npm run security:check-client",
    "preview": "astro preview",
    "security:check-client": "node scripts/check-client-secrets.mjs",
    "check": "astro check",
    "studio": "sanity dev --host 0.0.0.0",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "sanity:migrate-journal": "tsx scripts/migrate-markdown-body.ts",
    "sanity:migrate-journal:dry": "tsx scripts/migrate-markdown-body.ts --dry-run",
    "sanity:sync-assets": "tsx scripts/sync-sanity-assets.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^9.0.5",
    "@excalidraw/excalidraw": "^0.18.1",
    "@sanity/client": "^7.26.2",
    "@sanity/ui": "^3.5.3",
    "@sanity/vision": "^4.22.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^5.16.0",
    "easymde": "^2.21.0",
    "hls.js": "^1.7.3",
    "marked": "^18.1.1",
    "mongodb": "^6.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.1",
    "sanity": "^4.22.1",
    "sanity-plugin-markdown": "^7.0.4",
    "simple-icons": "^16.0.0",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12"
  }
}
