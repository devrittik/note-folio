---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/system/SectionHeader.astro';
import ImageCarousel from '../../components/ImageCarousel';
import RelatedSidebar from '../../components/RelatedSidebar.astro';
import SharePanel from '../../components/SharePanel.astro';
import {rankRelated} from '../../lib/content/related';
import {getJournalBySlug,getJournalEntries,getSiteSettings} from '../../lib/data';
import {breadcrumbSchema} from '../../lib/seo/schema';
const [entry,settings,journals]=await Promise.all([
  getJournalBySlug(Astro.params.slug || ''),
  getSiteSettings(),
  getJournalEntries()
]);
if(!entry) return Astro.rewrite('/404');
const journalImages=entry.body.filter((item)=>item.type==='image');
const journalParagraphs=entry.body.filter((item)=>item.type==='paragraph');
const relatedEntries=rankRelated(entry,journals.filter((item)=>item.slug!==entry.slug),(item)=>item.tags).map((item)=>({
  href:`/journal/${item.slug}`,
  title:item.title,
  meta:item.date.slice(0,7).replace('-','.'),
  tags:item.tags
}));
const canonicalPath=`/journal/${entry.slug}`;
const title=entry.seoTitle || `${entry.title} | ${settings.name}`;
const description=entry.seoDescription || entry.excerpt;
const fallbackImage=journalImages[0];
const seoImage=entry.seoImageUrl || fallbackImage?.url;
const seoImageAlt=entry.seoImageAlt || fallbackImage?.alt || `${entry.title} — ${settings.name}`;
const seoImageWidth=entry.seoImageUrl?entry.seoImageWidth:fallbackImage?.width;
const seoImageHeight=entry.seoImageUrl?entry.seoImageHeight:fallbackImage?.height;
const articleSchema:Record<string,unknown>={
  '@context':'https://schema.org',
  '@type':'Article',
  headline:entry.title,
  description,
  url:new URL(canonicalPath,Astro.site).toString(),
  mainEntityOfPage:new URL(canonicalPath,Astro.site).toString(),
  datePublished:entry.date,
  author:{'@id':`${new URL('/',Astro.site)}#person`},
  isPartOf:{'@id':`${new URL('/',Astro.site)}#website`},
  keywords:entry.tags.join(', '),
  articleBody:journalParagraphs.map((paragraph)=>paragraph.text).join('\n\n'),
  inLanguage:'en-IN',
  isAccessibleForFree:true
};
if(entry.updatedAt) articleSchema.dateModified=entry.updatedAt;
if(seoImage) articleSchema.image=new URL(seoImage,Astro.site).toString();
const jsonLd=[
  breadcrumbSchema(Astro.site!,[{name:'Home',path:'/'},{name:'Journal',path:'/journal'},{name:entry.title,path:canonicalPath}]),
  articleSchema
];
---
<Base title={title} description={description} canonicalPath={canonicalPath} type="article" image={seoImage} imageAlt={seoImageAlt} imageWidth={seoImageWidth} imageHeight={seoImageHeight} publishedTime={entry.date} modifiedTime={entry.updatedAt} tags={entry.tags} jsonLd={jsonLd}>
  <header class="pagehead detail-header">
    <div class="eyebrow">[Entry // {entry.date.slice(0,7).replace('-','.')} · {entry.readTime} min]</div>
    <h1 class:list={['entry-title',{'is-long':entry.title.length>38}]}>{entry.title}</h1>
    <p class="case-subtitle">{entry.excerpt}</p>
    <div style="margin-top:25px">{entry.tags.map((tag)=><span class="tag">{tag}</span>)}</div>
  </header>

  <div class="detail-layout">
    <article class="section article detail-main">
      <SectionHeader number="01" title="Transmission"/>
      {journalImages.length>0&&<ImageCarousel images={journalImages} label="JOURNAL FIGURES" client:visible />}
      {journalParagraphs.map((paragraph)=><p>{paragraph.text}</p>)}
      <div class="detail-share"><SharePanel title={entry.title} path={Astro.url.pathname}/></div>
    </article>

    <aside class="detail-sidebar">
      <RelatedSidebar title="SIMILAR ENTRIES" items={relatedEntries}/>
    </aside>
  </div>
</Base>
