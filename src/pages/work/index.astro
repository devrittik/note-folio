---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/system/SectionHeader.astro';
import ArchivePagination from '../../components/ArchivePagination';
import {getProjects,getSiteSettings} from '../../lib/data';
const [projects,settings]=await Promise.all([getProjects(),getSiteSettings()]);
const requestedPage=Number(Astro.url.searchParams.get('page') || '1');
const initialPage=Number.isInteger(requestedPage)&&requestedPage>0?requestedPage:1;
const archiveItems=projects.map((project,index)=>({
  href:`/work/${project.slug}`,
  sequence:index+1,
  title:project.title,
  excerpt:project.oneLiner,
  tags:project.techStack,
  status:project.status
}));
---
<Base title={`Selected Work — ${settings.name}`}>
  <header class="pagehead">
    <div class="eyebrow">[01 // Project Index]</div>
    <h1>{settings.workTitle}</h1>
    <div class="lede">{settings.workIntro}</div>
  </header>
  <section class="section">
    <SectionHeader number="02" title="Project Records" meta={`${projects.length} systems total`}/>
    <ArchivePagination kind="projects" items={archiveItems} initialPage={initialPage} pageSize={4} client:load />
  </section>
</Base>
