---
import Base from '../layouts/Base.astro';
Astro.response.status=404;
---
<Base title="Page Not Found | Engineering Notebook" description="The requested Engineering Notebook record could not be found." canonicalPath="/404" noindex={true}>
  <header class="pagehead">
    <div class="eyebrow">[ERR // 404]</div>
    <h1>Record<br/>not found.</h1>
    <p class="lede">The requested system entry does not exist.</p>
    <a class="button-link" href="/">Return to the Engineering Notebook index ↗</a>
  </header>
</Base>
