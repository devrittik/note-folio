---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/system/SectionHeader.astro';
import ContactForm from '../components/ContactForm';
import {getSiteSettings,getWhatsappHref} from '../lib/data';
import {githubDisplayPath,linkedinDisplayPath} from '../lib/content/profileLinks';
import {breadcrumbSchema} from '../lib/seo/schema';
const settings=await getSiteSettings();
const whatsappHref=getWhatsappHref(settings);
const githubLabel=githubDisplayPath(settings.github);
const linkedinLabel=linkedinDisplayPath(settings.linkedin);
const title=`Contact ${settings.name} | ${settings.role}`;
const jsonLd=[
  breadcrumbSchema(Astro.site!,[{name:'Home',path:'/'},{name:'Contact',path:'/contact'}]),
  {'@context':'https://schema.org','@type':'ContactPage',name:title,url:new URL('/contact',Astro.site),description:settings.contactHeadline,mainEntity:{'@id':`${new URL('/',Astro.site)}#person`}}
];
---
<Base title={title} description={settings.contactHeadline} canonicalPath="/contact" jsonLd={jsonLd}>
  <header class="pagehead">
    <div class="eyebrow">[01 // Communications Gateway]</div>
    <h1>{settings.contactTitle}</h1>
    <div class="lede">{settings.contactHeadline}</div>
  </header>

  <section class="section">
    <SectionHeader number="02" title="Send a Message" meta="Direct Pipeline"/>
    <ContactForm directEmail={settings.email} client:visible/>
  </section>

  <section class="section">
    <SectionHeader number="03" title="Other Ways to Connect" meta="System Channels"/>
    <div class="directory">
      <div class="directory-row"><b>Email reference</b><a class="signal" href={`mailto:${settings.email}`}>{settings.email}</a></div>
      <div class="directory-row"><b>GitHub endpoint</b><a href={settings.github} target="_blank" rel="noopener noreferrer">{githubLabel}</a></div>
      <div class="directory-row"><b>Professional index</b><a href={settings.linkedin} target="_blank" rel="noopener noreferrer">{linkedinLabel}</a></div>
      <div class="directory-row"><b>WhatsApp channel</b><a href={whatsappHref} target="_blank" rel="noopener noreferrer">{settings.whatsappDisplay}</a></div>
    </div>
  </section>

  <section class="section">
    <SectionHeader number="04" title="Availability Log" meta="Updated currently"/>
    <div class="availability">
      <div class="note-title">Status record // Live</div>
      <div class="note-row"><b>Availability</b><span>{settings.contactIntro}</span></div>
      <div class="note-row"><b>Response time</b><span>{settings.responseTime}</span></div>
      <div class="note-row"><b>Timezone</b><span>{settings.timezone}</span></div>
    </div>
  </section>
</Base>
