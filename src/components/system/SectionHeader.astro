---
interface Props { number: string; title: string; meta?: string; metaHref?: string; }
const { number, title, meta, metaHref } = Astro.props;
---
<div class="section-head">
  <h2 class="section-label">[{number} // {title}]</h2>
  {meta && (metaHref
    ? <a class="section-meta section-meta-link transition-mechanical" href={metaHref}>{meta}</a>
    : <div class="section-meta">{meta}</div>)}
</div>
